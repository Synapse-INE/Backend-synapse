NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_NAME=ine_session
SESSION_COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
TRUSTED_PROXY_CIDRS=
# URL pública del frontend; se usa para armar los enlaces de los correos.
FRONTEND_URL=http://localhost:5173
EMAIL_TOKEN_TTL_HOURS=24
INVITATION_TTL_HOURS=72
# Dominios permitidos para el registro de solicitantes (separados por coma); vacío = cualquiera.
REGISTRO_DOMINIOS_PERMITIDOS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# False requires STARTTLS; true uses implicit TLS.
SMTP_SECURE=false
POSTGRES_DB=precios_referencia
POSTGRES_USER=precios
POSTGRES_PASSWORD=cambiar-esta-clave-local
DATABASE_URL=postgresql://precios:cambiar-esta-clave-local@localhost:5432/precios_referencia

# Límite del archivo de catálogo oficial aceptado por el importador CLI.
IMPORT_INE_MAX_FILE_BYTES=52428800
