NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
POSTGRES_DB=precios_referencia
POSTGRES_USER=precios
POSTGRES_PASSWORD=cambiar-esta-clave-local
DATABASE_URL=postgresql://precios:cambiar-esta-clave-local@localhost:5432/precios_referencia

# Seguridad y sesiones. Sustituye JWT_ACCESS_SECRET por un secreto aleatorio de 32+ caracteres.
JWT_ACCESS_SECRET=cambiar-por-un-secreto-largo-aleatorio-de-al-menos-32-caracteres
JWT_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=7
AUTH_ACCESS_COOKIE_NAME=ine_access
AUTH_REFRESH_COOKIE_NAME=ine_refresh
AUTH_CSRF_COOKIE_NAME=ine_csrf
AUTH_CSRF_HEADER_NAME=x-csrf-token
# false permite cookies sobre HTTP solo en desarrollo local. Debe ser true en producción.
COOKIE_SECURE=false
# Activar exclusivamente detrás de un proxy/CDN de confianza que controle el acceso directo.
CF_TRUSTED_PROXY=false

# Límite del archivo de catálogo oficial aceptado por el importador CLI.
IMPORT_INE_MAX_FILE_BYTES=52428800
