NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_NAME=ine_session
SESSION_COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
TRUSTED_PROXY_CIDRS=
SWAGGER_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# False requires STARTTLS; true uses implicit TLS.
SMTP_SECURE=false
POSTGRES_DB=precios_referencia
POSTGRES_USER=precios
POSTGRES_PASSWORD=cambiar-esta-clave-local
POSTGRES_PORT=5432
DATABASE_URL=postgresql://precios:cambiar-esta-clave-local@localhost:5432/precios_referencia

# Activar solo en una base aislada para evaluación; las contraseñas deben ser secretos únicos.
DEMO_SEED_ENABLED=false
DEMO_SEED_ENVIRONMENT=
DEMO_SEED_DATABASE_NAME=
DEMO_SEED_CONFIRMATION=
DEMO_ADMIN_PASSWORD=
DEMO_JEFE_PASSWORD=
DEMO_TRABAJADOR_INE_PASSWORD=
DEMO_PROVEEDOR_PASSWORD=
DEMO_SOLICITANTE_PASSWORD=

# Límite del archivo de catálogo oficial aceptado por el importador CLI.
IMPORT_INE_MAX_FILE_BYTES=52428800

# Vigencia (horas) del enlace de restablecimiento de contraseña.
RESET_TOKEN_TTL_HOURS=1
